{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://medizininformatik-initiative.de/fdpg/ClinicalCohortDefinitionLanguage/whiteList/v1/schema",
    "type": "object",
    "required": ["version", "dataExtraction"],
    "properties": {
      "version": {
        "type": "string",
        "pattern": "^1\\.\\d+\\.\\d+$",
        "description": "Semantic version of the whitelist format this document conforms to. Must be a 1.x.y release matching this schema's major version."
      },
      "dataExtraction": {
        "type": "object",
        "required": ["attributeGroups"],
        "properties": {
          "attributeGroups": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["groupReference", "attributes"],
              "properties": {
                "groupReference": {
                  "type": "string"
                },
                "attributes": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["attributeRef"],
                    "properties": {
                      "attributeRef": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
  