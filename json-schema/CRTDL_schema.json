{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://medizininformatik-initiative.de/fdpg/ClinicalResourceTransferDefinitionLanguage/v2/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^2\\.\\d+\\.\\d+$",
      "description": "Semantic version of the CRTDL format this document conforms to. Must be a 2.x.y release matching this schema's major version."
    },
    "display": {
      "type": "string",
      "description": "A display string."
    },
    "cohortDefinition": {
      "$ref": "https://medizininformatik-initiative.de/fdpg/ClinicalCohortDefinitionLanguage/v2/schema",
      "description": "Reference to a cohort definition in CCDL schemas."
    },
    "dataExtraction": {
      "type": "object",
      "properties": {
        "attributeGroups": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "description": "Human-readable label for this attribute group. Determines the output file name via the slugification algorithm (§ Output file names). Must be unique after slugification across all attributeGroups in the CRTDL.",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^\\S(.*\\S)?$"
              },
              "groupReference": {
                "type": "string",
                "format": "uri",
                "minLength": 1
              },
              "includeReferenceOnly": {
                "type": "boolean"
              },
              "attributes": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "properties": {
                    "attributeRef": {
                      "type": "string",
                      "minLength": 1
                    },
                    "mustHave": {
                      "type": "boolean"
                    },
                    "linkedGroups": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "required": [
                    "attributeRef",
                    "mustHave"
                  ]
                }
              },
              "filter": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "codes": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "code": {
                            "type": "string"
                          },
                          "system": {
                            "type": "string",
                            "format": "uri"
                          },
                          "display": {
                            "type": "string"
                          },
                          "version": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "code",
                          "system",
                          "display"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "start": {
                      "type": "string",
                      "format": "date"
                    },
                    "end": {
                      "type": "string",
                      "format": "date"
                    }
                  },
                  "required": [
                    "type",
                    "name"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "groupReference",
              "attributes",
              "id",
              "name"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "attributeGroups"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "cohortDefinition",
    "dataExtraction"
  ],
  "additionalProperties": false
}
  